eval("{module.exports = /*#__PURE__*/JSON.parse('{\"ui\":{\"title\":\"Все проекты\",\"home\":\"Главная\",\"intro\":\"От первых коммерческих сайтов до B2B-платформ и real-time систем.\",\"search\":\"Поиск проектов\",\"filter\":\"Технологии\",\"filterHint\":\"Показать проекты со всеми выбранными технологиями\",\"details\":\"Подробнее\",\"contact\":\"Обсудить проект\",\"empty\":\"Ничего не найдено. Измените запрос или выбранные технологии.\",\"reset\":\"Сбросить фильтры\",\"missing\":\"Проект не найден\",\"year\":\"Период\",\"stack\":\"Полный стек проекта\",\"about\":\"О проекте\",\"shown\":\"Найдено\",\"sort\":\"Сортировка\",\"newest\":\"По годам: сначала новые\",\"oldest\":\"По годам: сначала старые\",\"az\":\"По алфавиту: А–Я\",\"za\":\"По алфавиту: Я–А\",\"grid\":\"Карточки\",\"list\":\"Список\",\"prev\":\"Предыдущая\",\"next\":\"Следующая\",\"pages\":\"Страницы проектов\",\"page\":\"Страница\",\"photos\":\"Изображения проекта\",\"prevPhoto\":\"Предыдущее изображение\",\"nextPhoto\":\"Следующее изображение\",\"openFilters\":\"Поиск и фильтры\",\"closeFilters\":\"Скрыть фильтры\",\"dateNote\":\"Период известен приблизительно\",\"frontend\":\"Frontend\",\"backend\":\"Backend\",\"cms\":\"CMS и движки\",\"data\":\"Базы данных и поиск\",\"realtime\":\"Real-time и очереди\",\"infrastructure\":\"Инфраструктура\",\"integrations\":\"API и интеграции\"},\"items\":{\"fifth-ocean\":{\"title\":\"Пятый океан\",\"role\":\"Самостоятельная разработка и поддержка\",\"summary\":\"Сайт туристической компании в Херсоне: каталоги, предложения и сопровождение после запуска.\",\"body\":\"Один из первых полноценных коммерческих проектов. Интегрировал готовую вёрстку с Joomla 3, разработал каталоги и карточки туристических предложений.\\\\n\\\\nПосле запуска сопровождал сайт, исправлял ошибки и восстанавливал его после атак и попыток взлома. Этот опыт стал переходом от экспериментов к разработке и поддержке реального продукта.\"},\"autocity\":{\"title\":\"АвтоСити\",\"role\":\"Web Developer · Wezom · командная разработка\",\"summary\":\"Участие в развитии автомобильной платформы с большой базой машин и совместимых запчастей.\",\"body\":\"Работал в существующем крупном проекте, а не создавал всю платформу с нуля. Дорабатывал каталоги, фильтрацию и функционал автомобильных запчастей.\\\\n\\\\nПоследовательный выбор марки, года, кузова и модели позволял подбирать совместимые группы деталей. Проект дал опыт командной работы с большой базой данных и работающей production-системой.\"},\"call-center\":{\"title\":\"Call-center / Real-time Status Module\",\"role\":\"Доработка существующей системы · автор real-time модуля\",\"summary\":\"Модуль состояния call-центра и занятости операторов в реальном времени.\",\"body\":\"Участвовал в доработке существующего call-центра на Yii2. Самостоятельно реализовал модуль отображения состояния системы и занятости операторов через JavaScript и WebSocket.\\\\n\\\\nОтдельной задачей была стабильная работа защищённого соединения HTTPS/WSS. Позже другой разработчик переписал модуль на Node.js; здесь представлен мой вклад в первоначальную рабочую версию, а не авторство всего call-центра.\"},\"vezdevoz\":{\"title\":\"Vezdevoz\",\"role\":\"Full Stack Developer · Inceptium / StarFix · под ключ\",\"summary\":\"Сервис попутных грузоперевозок с маршрутами и поиском грузов по пути.\",\"body\":\"Практически полностью реализовал сервис от начала до рабочего продукта. Перевозчик задавал маршрут, а заказчик мог найти транспорт, движущийся в нужном направлении, и занять свободное место для груза.\\\\n\\\\nНесколько раз очищал и перестраивал приобретённую базу городов, регионов и стран мира для быстрого поиска. Через Google Maps API рассчитывались маршрут, расстояние, направление и время поездки.\"},\"platcms\":{\"title\":\"PlatCMS / PlatP CMS\",\"role\":\"Собственный проект · разработка CMS\",\"summary\":\"Лёгкая модульная CMS, на которой было создано более двадцати сайтов.\",\"body\":\"Разработка началась в августе 2017 года после выкупа прав на предыдущую систему. Архитектура использовала идеи OpenCart и ShopScript; плагины OpenCart можно было адаптировать с минимальными изменениями.\\\\n\\\\nСоздал модули SEO, посадочных страниц, оплаты, тегов, PDF, локализации, событий, шаблонов, ошибок и настроек. На CMS работало более двадцати сайтов. Позже развитие остановил: современные фреймворки стали эффективнее решать те же задачи.\"},\"comfort-club\":{\"title\":\"Comfort Club\",\"role\":\"Коммерческая разработка · первый заказ на PlatCMS\",\"summary\":\"Интерактивный каталог жилого комплекса: от корпуса и этажа до планировки квартиры.\",\"body\":\"Первый коммерческий сайт на новой версии PlatCMS, созданный в декабре 2017 года. За простым интерфейсом находилась иерархия корпусов, подъездов, этажей и квартир.\\\\n\\\\nПосетитель выбирал дом на изображении, переходил к этажу и квартире, видел площадь и параметры помещений, планировки и фотографии. Административная часть позволяла создавать всю структуру комплекса; виды из окон показывались при наличии материалов.\"},\"oncoplastic-surgery\":{\"title\":\"Oncoplastic Surgery\",\"role\":\"Коммерческий landing page\",\"summary\":\"Посадочная страница с формами обратной связи и приёмом платежей.\",\"body\":\"Создал компактный коммерческий сайт с формами обратной связи и подключением оплаты.\\\\n\\\\nПроект стал этапом развития PlatCMS: в феврале 2018 года в движке впервые появились платёжные плагины. Этот механизм затем можно было повторно использовать и расширять в других проектах.\"},\"dolce-bella\":{\"title\":\"Dolce Bella\",\"role\":\"Коммерческий сайт сети салонов красоты\",\"summary\":\"Сайт сети салонов в Херсоне с записью и посадочными страницами услуг.\",\"body\":\"Проект включал структуру нескольких салонов, запись и отдельные посадочные страницы направлений и услуг.\\\\n\\\\nНа подобных задачах развивал SEO-возможности PlatCMS: метаданные, структуру страниц и поисковое продвижение. Dolce Bella стал одним из проектов, превративших небольшую CMS в набор универсальных инструментов для бизнеса.\"},\"fish-meat\":{\"title\":\"Meat & Fish\",\"role\":\"Коммерческая разработка для ресторана\",\"summary\":\"Ресторанное меню с составом блюд, ингредиентами, предзаказом и бронированием столиков.\",\"body\":\"Для ресторана в Санкт-Петербурге разработал насыщенное меню, где можно было менять состав отдельных блюд, например комплектацию пиццы. Ингредиенты были самостоятельными сущностями с фотографиями и описаниями.\\\\n\\\\nБлюда, категории и ингредиенты связывались системой зависимостей. Проект включал бронирование и предварительные заказы; работа над ним расширила каталоги, теги и связи сущностей в PlatCMS.\"},\"prime\":{\"title\":\"Prime / InfoRegion\",\"role\":\"Freelance · сеть тренажёрных залов\",\"summary\":\"Сайт трёх спортивных клубов с тренерами и записью на определённое время.\",\"body\":\"Разработал сайт для сети из трёх тренажёрных залов в Херсоне. У каждого клуба были собственные тренеры; посетитель мог выбрать специалиста и время занятия.\\\\n\\\\nСайт объединял филиалы, сотрудников и расписания и показывал, как PlatCMS можно адаптировать под спортивные клубы. Проект относится к freelance-периоду 2016–2021; точный год пока не восстановлен.\"},\"antosh-co\":{\"title\":\"Antosh & Co\",\"role\":\"Публичный landing и закрытая внутренняя система\",\"summary\":\"Закрытый marketplace специалистов за публичной страницей компании.\",\"body\":\"Публичный сайт был оболочкой для внутреннего инструмента с ограниченным доступом. Пользователи могли находить доступных исполнителей, включая программистов и верстальщиков, под конкретную задачу.\\\\n\\\\nОсновной функционал находился в закрытой части для круга людей, сотрудничавших с владельцем проекта. Проект создан на PlatCMS и относится к январю 2020 года.\"},\"haukun\":{\"title\":\"Haukun\",\"role\":\"Международный коммерческий проект · Германия / Европа\",\"summary\":\"Поиск товаров и объявлений в заданном радиусе с картами и оплатой.\",\"body\":\"Посетитель выбирал город и радиус, например Берлин и 50 км, затем искал нужный товар. Система определяла географическую область и находила подходящие предложения.\\\\n\\\\nВнешний географический API преобразовывал координаты и радиусы в населённые пункты, после чего внутренняя база искала объявления. Использовались Google Maps API и платёжные плагины. Проект относится к сентябрю 2020 года.\"},\"tourist-booking\":{\"title\":\"Tourist Booking Platform\",\"role\":\"Существенная доработка существующего проекта · Израиль\",\"summary\":\"Переработка бронирования экскурсий с участниками, трансфером и вариантами возвращения.\",\"body\":\"Получил уже работающий туристический сайт на WordPress и переработал значительную часть его функционала. Система предлагала экскурсии туристам, проживающим в определённых отелях.\\\\n\\\\nВ оформлении учитывались взрослые и дети, экскурсия и трансфер. После тура можно было выбрать возвращение в отель или другую точку высадки. Используется рабочее название: точное название и год внутри периода 2016–2021 пока не восстановлены.\"},\"colortech\":{\"title\":\"ColorTech ERP / WMS\",\"role\":\"SmartGamma · восстановление и адаптация legacy-системы\",\"summary\":\"Восстановление ERP/WMS производственного предприятия и работа с приёмкой по штрихкодам.\",\"body\":\"Работал с существующей системой чешского предприятия по обработке и окраске металлических изделий. Разбирался в архитектуре и связях ERP, WMS Desktop и WMS Mobile, искал точки входа и частично восстановил работоспособность.\\\\n\\\\nОтдельное направление — мобильная приёмка материалов: сотрудник сканировал штрихкод, а система определяла товар для складского учёта. Мой вклад — восстановление и адаптация, а не разработка исходной ERP с нуля.\"},\"service-market\":{\"title\":\"ServiceMarket\",\"role\":\"Linecore · командная разработка e-commerce\",\"summary\":\"Крупный интернет-магазин бытовой техники, электроники и запчастей с каталогами и заказами.\",\"body\":\"Участвовал в создании основной части проекта: поднимал структуру приложения, интегрировал готовые шаблоны, создавал каталоги и значительную часть основного функционала. По моей оценке, к передаче следующего этапа было реализовано около половины проекта.\\\\n\\\\nКаталог включал множество категорий, фильтры, карточки товаров и обработку заказов. Redis и Elasticsearch входят в стек проекта, но их настройкой в основном занимался другой разработчик.\"},\"smartmag\":{\"title\":\"SmartMag\",\"role\":\"Linecore · командная разработка e-commerce\",\"summary\":\"Магазин электроники и бытовой техники с фильтрацией, сравнением и отслеживанием заказов.\",\"body\":\"Проект был архитектурно близок к ServiceMarket, но имел более компактный ассортимент: смартфоны, аксессуары, power bank и бытовую технику.\\\\n\\\\nПользователи могли фильтровать и сравнивать товары, оформлять и отслеживать заказы. Применялись кэширование и поисковые механизмы. Для меня это было продолжение работы с Laravel-based e-commerce и повторно используемой логикой каталогов и заказов.\"},\"tcars\":{\"title\":\"Tesla / TCarService\",\"role\":\"Linecore · автомобильная e-commerce платформа\",\"summary\":\"Автомобили Tesla, подержанные машины, запчасти и заявки на обслуживание для рынка США.\",\"body\":\"Платформа компании, работавшей с автомобилями Tesla на американском рынке, объединяла автомобили, подержанные машины, запчасти и сервисные услуги.\\\\n\\\\nМожно было просматривать предложения, работать с категориями и фильтрами и оставлять заявки на обслуживание и диагностику. Проект использовал ту же линейку Laravel e-commerce решений, что SmartMag и ServiceMarket.\"},\"hmh-expert\":{\"title\":\"HMH Expert\",\"role\":\"Senior Full Stack Developer · NicelyGroup\",\"summary\":\"B2B-платформа с товарами, услугами, заказами и корпоративным мессенджером.\",\"body\":\"Работал над сервисами авторизации и регистрации, менеджером сообщений на Matrix Synapse, WebSocket и React, переработкой API и архитектуры авторизации.\\\\n\\\\nПлатформа объединяла компании и малый бизнес, размещение товаров и услуг, заказы и общение. Задачи затрагивали frontend, backend, real-time, очереди, отдельные базы данных и файловое хранилище. Период работы в NicelyGroup — май–ноябрь 2025.\"}}}');\n\n//# sourceURL=webpack://pashapilat-gitsite/./src/i18n/data/ru/projects.json?\n}");

